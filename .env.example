NODE_ENV=development
API_PORT=4000
WEB_PORT=3001
WORKER_HEALTH_PORT=4001
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Obtain these values from the Supabase dashboard.
# Use Supabase's direct connection for migrations and transaction pooler for runtime where appropriate.
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@REGION.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_DATABASE_URL=postgresql://postgres:REPLACE_ME@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_ME
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
PII_HASH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# Required only to activate Razorpay checkout. Never expose secrets with NEXT_PUBLIC_/EXPO_PUBLIC_ prefixes.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
