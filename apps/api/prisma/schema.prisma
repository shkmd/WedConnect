  amountPaise Int            @map("amount_paise")
  taxPaise    Int            @default(0) @map("tax_paise")
  currency    String         @default("INR") @db.VarChar(3)
  issuedAt    DateTime       @default(now()) @map("issued_at") @db.Timestamptz(6)
  business    VendorBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  order       BillingOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([businessId, issuedAt])
  @@map("invoices")
}

model PaymentWebhookEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerEventId String    @unique @map("provider_event_id") @db.VarChar(120)
  eventType       String    @map("event_type") @db.VarChar(80)
  payloadHash     String    @map("payload_hash") @db.VarChar(64)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  error           String?   @db.VarChar(1000)
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([processedAt, receivedAt])
  @@map("payment_webhook_events")
}

model PromotionCampaign {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String         @map("business_id") @db.Uuid
  cityId          String         @map("city_id") @db.Uuid
  localityId      String?        @map("locality_id") @db.Uuid
  categoryId      String         @map("category_id") @db.Uuid
  startsAt        DateTime       @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime       @map("ends_at") @db.Timestamptz(6)
  impressionLimit Int            @map("impression_limit")
  clickLimit      Int            @map("click_limit")
  frequencyCap    Int            @map("frequency_cap")
  impressions     Int            @default(0)
  clicks          Int            @default(0)
  status          CampaignStatus @default(DRAFT)
  disclosure      String         @default("Sponsored") @db.VarChar(40)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  business        VendorBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([cityId, categoryId, status, startsAt, endsAt])
  @@index([businessId, status])
  @@map("promotion_campaigns")
}

model MobilePushToken {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  token      String         @unique @db.VarChar(300)
  platform   DevicePlatform
  deviceName String?        @map("device_name") @db.VarChar(120)
  active     Boolean        @default(true)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, active])
  @@map("mobile_push_tokens")
}

model NotificationPreference {
  userId             String                 @id @map("user_id") @db.Uuid
  transactionalPush  Boolean                @default(true) @map("transactional_push")
  transactionalEmail Boolean                @default(true) @map("transactional_email")
  transactionalSms   Boolean                @default(false) @map("transactional_sms")
  marketingPush      Boolean                @default(false) @map("marketing_push")
  marketingEmail     Boolean                @default(false) @map("marketing_email")
  quietHoursStart    String?                @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd      String?                @map("quiet_hours_end") @db.VarChar(5)
  timezone           String                 @default("Asia/Kolkata") @db.VarChar(60)
  digestMode         NotificationDigestMode @default(IMMEDIATE) @map("digest_mode")
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_preferences")
}

model PrivacyRequest {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  type             PrivacyRequestType
  status           PrivacyRequestStatus @default(OPEN)
  details          String?              @db.VarChar(2000)
  resolution       String?              @db.VarChar(2000)
  exportObjectPath String?              @map("export_object_path") @db.VarChar(700)
  verifiedAt       DateTime?            @map("verified_at") @db.Timestamptz(6)
  completedAt      DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, status, createdAt])
  @@index([status, type, createdAt])
  @@map("privacy_requests")
}

model AnalyticsEvent {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String   @db.VarChar(80)
  anonymousSessionHash String   @map("anonymous_session_hash") @db.VarChar(64)
  properties           Json     @default("{}")
  schemaVersion        Int      @default(1) @map("schema_version")
  occurredAt           DateTime @map("occurred_at") @db.Timestamptz(6)
  receivedAt           DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([name, occurredAt])
  @@map("analytics_events")
}

model RetentionExecution {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobName     String    @map("job_name") @db.VarChar(80)
  deletedRows Int       @default(0) @map("deleted_rows")
  status      String    @db.VarChar(20)
  error       String?   @db.VarChar(1000)
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([jobName, startedAt])
  @@map("retention_executions")
}
