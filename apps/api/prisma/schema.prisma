generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
  DELETED
}

enum RoleCode {
  CUSTOMER
  VENDOR_OWNER
  VENDOR_STAFF
  VERIFIER
  MODERATOR
  SUPER_ADMIN
}

enum ScopeType {
  PLATFORM
  VENDOR_BUSINESS
}

enum ConsentAction {
  GRANTED
  WITHDRAWN
}

enum LocationType {
  COUNTRY
  STATE
  DISTRICT
  CITY
  LOCALITY
}

enum CategoryFieldType {
  TEXT
  NUMBER
  BOOLEAN
  SINGLE_SELECT
  MULTI_SELECT
}

enum DefinitionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProfessionalType {
  FREELANCER
  SOLE_PROPRIETOR
  STUDIO
  AGENCY
  REGISTERED_COMPANY
  VENUE_PROPERTY
  PERFORMER
  BOUTIQUE_RENTAL
}

enum VendorStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum VendorMemberRole {
  OWNER
  STAFF
}

enum PricingType {
  FIXED
  STARTING_FROM
  CUSTOM_QUOTE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ProcessingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  READY
  FAILED
  QUARANTINED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PortfolioFormat {
  SINGLE_IMAGE
  ALBUM
  SHORT_VIDEO
  REEL
}

enum CopyrightReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum RequirementStatus {
  DRAFT
  ACTIVE
  CANCELLED
  EXPIRED
}

enum ContactMethod {
  IN_APP
  PHONE
  WHATSAPP
  EMAIL
}

enum LeadStatus {
  NEW
  VIEWED
  RESPONDED
  CONTACT_SHARED
  IN_DISCUSSION
  CLOSED
  NOT_INTERESTED
  INVALID
  SPAM
  EXPIRED
}

enum InvalidReportStatus {
  OPEN
  APPROVED
  REJECTED
}

enum CreditLedgerReason {
  LEAD_RESPONSE
  REFUND
  ADMIN_GRANT
  ADJUSTMENT
  CREDIT_PACK_PURCHASE
  PROMOTIONAL_GRANT
  EXPIRY
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingOrderType {
  SUBSCRIPTION
  CREDIT_PACK
  PROMOTION
}

enum BillingOrderStatus {
  CREATED
  ATTEMPTED
  PAID
  FAILED
  REFUNDED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum DevicePlatform {
  IOS
  ANDROID
}

enum NotificationDigestMode {
  IMMEDIATE
  DAILY
  WEEKLY
  OFF
}

enum PrivacyRequestType {
  EXPORT
  CORRECTION
  DELETION
  CONSENT_WITHDRAWAL
}

enum PrivacyRequestStatus {
  OPEN
  VERIFYING
  PROCESSING
  COMPLETED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum VerificationScope {
  IDENTITY
  BUSINESS
  ADDRESS
  PORTFOLIO
}

enum VerificationCaseStatus {
  DRAFT
  SUBMITTED
  ASSIGNED
  CLARIFICATION_REQUIRED
  APPROVED
  REJECTED
  EXPIRED
}

enum EvidenceStatus {
  PENDING
  CLEAN
  QUARANTINED
  REJECTED
}

enum TrustReportType {
  COPYRIGHT
  IMPERSONATION
  PRIVACY
  FAKE_PORTFOLIO
  FRAUD
  REVIEW_DISPUTE
  OTHER
}

enum TrustCaseStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
  CLOSED
}

enum GrievanceType {
  PRIVACY
  VERIFICATION
  MODERATION
  SERVICE
  OTHER
}

enum AppealStatus {
  OPEN
  REVIEWING
  UPHELD
  OVERTURNED
  CLOSED
}

model AppUser {
  id                     String                  @id @db.Uuid
  status                 AccountStatus           @default(ACTIVE)
  displayName            String?                 @map("display_name") @db.VarChar(120)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles                  UserRole[]
  consents               ConsentRecord[]
  vendorMemberships      VendorMember[]
  acceptedVendorTerms    VendorTermsAcceptance[]
  mediaUploadIntents     MediaUploadIntent[]
  requirements           CustomerRequirement[]
  leadResponses          LeadResponse[]
  contactGrants          LeadContactGrant[]
  shortlists             CustomerShortlist[]
  reviews                VendorReview[]
  reviewModerationEvents ReviewModerationEvent[]

  @@map("app_users")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        RoleCode         @unique
  name        String           @db.VarChar(80)
  description String?          @db.VarChar(300)
  system      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @db.VarChar(120)
  description String?          @db.VarChar(300)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  scopeType ScopeType @default(PLATFORM) @map("scope_type")
  scopeId   String?   @map("scope_id") @db.Uuid
  grantedBy String?   @map("granted_by") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId, revokedAt])
  @@map("user_roles")
}

model ConsentRecord {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  purpose        String          @db.VarChar(120)
  action         ConsentAction
  noticeVersion  String          @map("notice_version") @db.VarChar(40)
  noticeTextHash String          @map("notice_text_hash") @db.VarChar(64)
  noticeText     String          @map("notice_text") @db.Text
  recipientId    String?         @map("recipient_id") @db.Uuid
  sharedFields   String[]        @default([]) @map("shared_fields")
  source         String          @db.VarChar(40)
  occurredAt     DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)
  supersedesId   String?         @map("supersedes_id") @db.Uuid
  user           AppUser         @relation(fields: [userId], references: [id], onDelete: Restrict)
  supersedes     ConsentRecord?  @relation("ConsentSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy   ConsentRecord[] @relation("ConsentSupersession")

  @@index([userId, purpose, occurredAt])
  @@map("consent_records")
}

model OtpSecurityEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectHash String   @map("subject_hash") @db.VarChar(64)
  ipHash      String?  @map("ip_hash") @db.VarChar(64)
  event       String   @db.VarChar(40)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([subjectHash, createdAt])
  @@index([ipHash, createdAt])
  @@map("otp_security_events")
}

model AdminMfaPolicy {
  userId     String    @id @map("user_id") @db.Uuid
  required   Boolean   @default(true)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin_mfa_policies")
}

model Location {
  id                     String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId               String?                    @map("parent_id") @db.Uuid
  type                   LocationType
  name                   String                     @db.VarChar(120)
  slug                   String                     @unique @db.VarChar(140)
  countryCode            String?                    @map("country_code") @db.VarChar(2)
  timezone               String?                    @db.VarChar(80)
  postalCodes            String[]                   @default([]) @map("postal_codes")
  latitude               Decimal?                   @db.Decimal(9, 6)
  longitude              Decimal?                   @db.Decimal(9, 6)
  active                 Boolean                    @default(true)
  sortOrder              Int                        @default(0) @map("sort_order")
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent                 Location?                  @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children               Location[]                 @relation("LocationTree")
  basedBusinesses        VendorBusiness[]           @relation("VendorBaseCity")
  vendorServiceAreas     VendorServiceArea[]
  portfolioPosts         PortfolioPost[]
  sponsoredPlacements    VendorSponsoredPlacement[]
  requirementsByCity     CustomerRequirement[]      @relation("RequirementCity")
  requirementsByLocality CustomerRequirement[]      @relation("RequirementLocality")

  @@index([parentId, type, active, sortOrder])
  @@map("locations")
}

model Category {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId            String?                    @map("parent_id") @db.Uuid
  name                String                     @db.VarChar(120)
  slug                String                     @unique @db.VarChar(140)
  description         String?                    @db.VarChar(500)
  active              Boolean                    @default(true)
  sortOrder           Int                        @default(0) @map("sort_order")
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent              Category?                  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children            Category[]                 @relation("CategoryTree")
  fields              CategoryFieldDefinition[]
  vendorCategories    VendorCategory[]
  vendorServices      VendorService[]
  portfolioPosts      PortfolioPost[]
  discoveryValues     VendorCategoryFieldValue[]
  sponsoredPlacements VendorSponsoredPlacement[]
  requirements        CustomerRequirement[]

  @@index([parentId, active, sortOrder])
  @@map("categories")
}

model CategoryFieldDefinition {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String            @map("category_id") @db.Uuid
  key        String            @db.VarChar(80)
  label      String            @db.VarChar(120)
  fieldType  CategoryFieldType @map("field_type")
  required   Boolean           @default(false)
  filterable Boolean           @default(false)
  comparable Boolean           @default(false)
  unit       String?           @db.VarChar(40)
  config     Json              @default("{}")
  version    Int               @default(1)
  status     DefinitionStatus  @default(DRAFT)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([categoryId, key, version])
  @@index([categoryId, status])
  @@map("category_field_definitions")
}

model VendorBusiness {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                     @db.VarChar(160)
  slug                String                     @unique @db.VarChar(180)
  professionalType    ProfessionalType           @map("professional_type")
  description         String?                    @db.Text
  yearsExperience     Int?                       @map("years_experience")
  languages           String[]                   @default([])
  baseCityId          String?                    @map("base_city_id") @db.Uuid
  outstationAvailable Boolean                    @default(false) @map("outstation_available")
  status              VendorStatus               @default(DRAFT)
  onboardingStep      Int                        @default(2) @map("onboarding_step")
  completionPercent   Int                        @default(10) @map("completion_percent")
  publicVisible       Boolean                    @default(false) @map("public_visible")
  submittedAt         DateTime?                  @map("submitted_at") @db.Timestamptz(6)
  approvedAt          DateTime?                  @map("approved_at") @db.Timestamptz(6)
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  baseCity            Location?                  @relation("VendorBaseCity", fields: [baseCityId], references: [id], onDelete: Restrict)
  members             VendorMember[]
  categories          VendorCategory[]
  serviceAreas        VendorServiceArea[]
  services            VendorService[]
  packages            VendorPackage[]
  terms               VendorTermsAcceptance[]
  moderationEvents    VendorModerationEvent[]
  mediaAssets         MediaAsset[]
  portfolioPosts      PortfolioPost[]
  discoveryProfile    VendorDiscoveryProfile?
  categoryFieldValues VendorCategoryFieldValue[]
  sponsoredPlacements VendorSponsoredPlacement[]
  leadRecipients      LeadRecipient[]
  creditAccount       VendorCreditAccount?
  shortlistItems      CustomerShortlistItem[]
  reviews             VendorReview[]
  verificationCases   VerificationCase[]
  verificationBadges  VerificationBadge[]
  trustReports        TrustReport[]
  subscriptions       VendorSubscription[]
  billingOrders       BillingOrder[]
  invoices            Invoice[]
  promotionCampaigns  PromotionCampaign[]

  @@index([status, updatedAt])
  @@map("vendor_businesses")
}

model VendorMember {
  businessId String           @map("business_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  role       VendorMemberRole @default(STAFF)
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  business   VendorBusiness   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       AppUser          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([businessId, userId])
  @@index([userId, active])
  @@map("vendor_members")
}

model VendorCategory {
  businessId String         @map("business_id") @db.Uuid
  categoryId String         @map("category_id") @db.Uuid
  isPrimary  Boolean        @default(false) @map("is_primary")
  business   VendorBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([businessId, categoryId])
  @@map("vendor_categories")
}

model VendorServiceArea {
  businessId String         @map("business_id") @db.Uuid
  locationId String         @map("location_id") @db.Uuid
  business   VendorBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location   Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([businessId, locationId])
  @@map("vendor_service_areas")
}

model VendorService {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String          @map("business_id") @db.Uuid
  categoryId  String          @map("category_id") @db.Uuid
  name        String          @db.VarChar(140)
  description String?         @db.VarChar(1000)
  pricingType PricingType     @map("pricing_type")
  price       Decimal?        @db.Decimal(12, 2)
  active      Boolean         @default(true)
  sortOrder   Int             @default(0) @map("sort_order")
  business    VendorBusiness  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  packages    VendorPackage[]

  @@index([businessId, active, sortOrder])
  @@map("vendor_services")
}

model VendorPackage {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String          @map("business_id") @db.Uuid
  serviceId      String?         @map("service_id") @db.Uuid
  name           String          @db.VarChar(140)
  description    String?         @db.VarChar(1200)
  price          Decimal         @db.Decimal(12, 2)
  inclusions     String[]        @default([])
  active         Boolean         @default(true)
  business       VendorBusiness  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service        VendorService?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  portfolioPosts PortfolioPost[]

  @@index([businessId, active])
  @@map("vendor_packages")
}

model VendorTermsAcceptance {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  version    String         @db.VarChar(40)
  termsHash  String         @map("terms_hash") @db.VarChar(64)
  acceptedAt DateTime       @default(now()) @map("accepted_at") @db.Timestamptz(6)
  business   VendorBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user       AppUser        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([businessId, version])
  @@map("vendor_terms_acceptances")
}

model VendorModerationEvent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String         @map("business_id") @db.Uuid
  actorUserId String         @map("actor_user_id") @db.Uuid
  fromStatus  VendorStatus   @map("from_status")
  toStatus    VendorStatus   @map("to_status")
  reason      String?        @db.VarChar(1000)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  business    VendorBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@map("vendor_moderation_events")
}

model MediaUploadIntent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  objectPath   String    @unique @map("object_path") @db.VarChar(500)
  mediaType    MediaType @map("media_type")
  mimeType     String    @map("mime_type") @db.VarChar(100)
  expectedSize Int       @map("expected_size")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user         AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([businessId, expiresAt])
  @@map("media_upload_intents")
}

model MediaAsset {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String                 @map("business_id") @db.Uuid
  objectPath       String                 @unique @map("object_path") @db.VarChar(500)
  mediaType        MediaType              @map("media_type")
  mimeType         String                 @map("mime_type") @db.VarChar(100)
  byteSize         Int                    @map("byte_size")
  width            Int?
  height           Int?
  durationSeconds  Int?                   @map("duration_seconds")
  processingStatus ProcessingStatus       @default(UPLOADED) @map("processing_status")
  moderationStatus ModerationStatus       @default(PENDING) @map("moderation_status")
  thumbnailPath    String?                @map("thumbnail_path") @db.VarChar(500)
  processedPath    String?                @map("processed_path") @db.VarChar(500)
  failureReason    String?                @map("failure_reason") @db.VarChar(500)
  retryCount       Int                    @default(0) @map("retry_count")
  rightsDeclared   Boolean                @default(false) @map("rights_declared")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  business         VendorBusiness         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  posts            PortfolioMedia[]
  moderationEvents MediaModerationEvent[]
  copyrightReports CopyrightReport[]

  @@index([businessId, processingStatus, moderationStatus])
  @@map("media_assets")
}

model PortfolioPost {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String            @map("business_id") @db.Uuid
  categoryId        String            @map("category_id") @db.Uuid
  cityId            String            @map("city_id") @db.Uuid
  relatedPackageId  String?           @map("related_package_id") @db.Uuid
  format            PortfolioFormat
  caption           String?           @db.VarChar(2200)
  eventType         String?           @map("event_type") @db.VarChar(80)
  tags              String[]          @default([])
  publicationStatus PublicationStatus @default(DRAFT) @map("publication_status")
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  business          VendorBusiness    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  city              Location          @relation(fields: [cityId], references: [id], onDelete: Restrict)
  relatedPackage    VendorPackage?    @relation(fields: [relatedPackageId], references: [id], onDelete: SetNull)
  media             PortfolioMedia[]

  @@index([businessId, publicationStatus, publishedAt])
  @@map("portfolio_posts")
}

model PortfolioMedia {
  postId    String        @map("post_id") @db.Uuid
  mediaId   String        @map("media_id") @db.Uuid
  sortOrder Int           @default(0) @map("sort_order")
  isCover   Boolean       @default(false) @map("is_cover")
  post      PortfolioPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  media     MediaAsset    @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([postId, mediaId])
  @@map("portfolio_media")
}

model MediaModerationEvent {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaId     String           @map("media_id") @db.Uuid
  actorUserId String           @map("actor_user_id") @db.Uuid
  decision    ModerationStatus
  reason      String?          @db.VarChar(1000)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  media       MediaAsset       @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([mediaId, createdAt])
  @@map("media_moderation_events")
}

model CopyrightReport {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaId       String                @map("media_id") @db.Uuid
  reporterEmail String                @map("reporter_email") @db.VarChar(254)
  statement     String                @db.VarChar(3000)
  status        CopyrightReportStatus @default(OPEN)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  media         MediaAsset            @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("copyright_reports")
}

model VendorDiscoveryProfile {
  businessId        String         @id @map("business_id") @db.Uuid
  verified          Boolean        @default(false)
  verificationScope String[]       @default([]) @map("verification_scope")
  averageRating     Decimal        @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount       Int            @default(0) @map("review_count")
